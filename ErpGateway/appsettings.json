{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Jwt": {
    "Key": "${JWT_SECRET_KEY}",
    "Issuer": "ErpGeneral",
    "Audience": "ErpGeneralUsers"
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/api/erp/auth/{**remainder}"
        }
      },
      "erp-route": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/api/erp/{**remainder}"
        },
        "Metadata": {
            "RequiresAuth": "true"
        }
      }
    },
    "Clusters": {
      "backend-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5100"
          }
        }
      }
    }
  }
}
