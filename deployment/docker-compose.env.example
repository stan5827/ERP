# Copy to the repository-root .env only after configuring the identity provider.
# Keep actual secrets out of source control; use an approved secret store.

# Must exactly match the "iss" claim issued to the supplier Portal browser.
# The backend container must also be able to reach this URL.
SUPPLIER_IDENTITY_AUTHORITY=https://identity.example.com/realms/supplier-portal
SUPPLIER_IDENTITY_AUDIENCE=supplier-portal-api

# Keycloak realm Admin API URL reachable from the backend container.
SUPPLIER_IDENTITY_ADMIN_BASE_URL=https://identity.example.com/admin/realms/supplier-portal
SUPPLIER_IDENTITY_ADMIN_CLIENT_ID=supplier-portal-backend
SUPPLIER_IDENTITY_ADMIN_CLIENT_SECRET=replace-via-secret-store
SUPPLIER_IDENTITY_INVITATION_LIFESPAN_SECONDS=86400
SUPPLIER_IDENTITY_REQUIRE_TOTP=true
SUPPLIER_IDENTITY_ALLOW_HTTP_METADATA=false
