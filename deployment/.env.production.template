# ============================================================
# ERP Backend - 生產環境變數模板 (.env.production.template)
#
# 使用方式：
#   1. 複製此檔案為 .env.production
#   2. 填入實際的生產環境密鑰與連線字串
#   3. 透過雲端密鑰服務（AWS Secrets Manager / Azure Key Vault / K8s Secrets）注入
#   4. 絕對不要將包含真實密鑰的 .env.production 提交到版本控制
# ============================================================

# ------------------------------------------------------------------
# 1. 資料庫連線 (PostgreSQL)
#    生產環境建議使用雲端受管理資料庫（Azure Database for PostgreSQL / AWS RDS）
#    連線字串應透過密鑰服務注入，禁止寫死在程式碼中
# ------------------------------------------------------------------
POSTGRES_DB=ErpGeneral
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=<REPLACE_WITH_STRONG_DATABASE_PASSWORD>

# ------------------------------------------------------------------
# 2. JWT 金鑰 (至少 32 字元)
#    生產環境務必產生隨機強密鑰，並定期輪替
# ------------------------------------------------------------------
JWT_SECRET_KEY=<REPLACE_WITH_32_CHAR_PLUS_RANDOM_STRING>

# ------------------------------------------------------------------
# 3. LLM / AI 服務金鑰
#    建議透過密鑰服務管理，不得硬編碼
# ------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=<REPLACE_WITH_LLM_API_KEY>
LLM_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_MODEL=gpt-4
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------
# 4. Redis 快取連線
# ------------------------------------------------------------------
REDIS_CONNECTION_STRING=redis:6379

# ------------------------------------------------------------------
# 5. Grafana administrator password
# ------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=<REPLACE_WITH_STRONG_GRAFANA_PASSWORD>

# ------------------------------------------------------------------
# 6. 管理員初始密碼 (首次部署後務必變更)
# ------------------------------------------------------------------
ADMIN_INITIAL_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>

# ------------------------------------------------------------------
# 7. 應用程式設定
# ------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# ------------------------------------------------------------------
# 8. 監控與告警
#    Alertmanager 通知目標（Slack Webhook / Email）
# ------------------------------------------------------------------
ALERTMANAGER_SLACK_WEBHOOK_URL=<REPLACE_WITH_SLACK_WEBHOOK>
ALERTMANAGER_EMAIL_SMTP_HOST=smtp.prod.internal
ALERTMANAGER_EMAIL_SMTP_PORT=587
ALERTMANAGER_EMAIL_FROM=erp-alerts@yourdomain.com
ALERTMANAGER_EMAIL_TO=devops@yourdomain.com

# ------------------------------------------------------------------
# 9. 日誌設定
# ------------------------------------------------------------------
LOGGING__LOGLEVEL__Default=Information
LOGGING__LOGLEVEL__Microsoft=Warning
LOGGING__LOGLEVEL__Microsoft.AspNetCore=Warning

# ------------------------------------------------------------------
# 10. 資料庫遷移控制
#    生產環境建議以 EF Core Migrations 手動或 CI/CD 執行，禁止自動遷移
# ------------------------------------------------------------------
EF_MIGRATIONS_ASSEMBLY=ErpBackend
DOTNET_STARTUP__ENVIRONMENT=Production
