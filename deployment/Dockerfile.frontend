# ============================================================
# ERP Frontend - React 19 + Vite Multi-stage Build
# Build: docker build -f deployment/Dockerfile.frontend -t erp-frontend:latest .
# ============================================================

# ---------- Stage 1: Build ----------
FROM node:24-alpine AS build
WORKDIR /app

# Copy package files and install dependencies
COPY erp-frontend/package.json erp-frontend/package-lock.json ./
RUN npm ci

# Copy source and build
COPY erp-frontend/ ./
RUN npm run build

# ---------- Stage 2: Nginx runtime ----------
FROM nginx:stable-alpine3.24 AS runtime
RUN apk upgrade --no-cache
COPY --from=build /app/dist /usr/share/nginx/html

# SPA fallback config
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
