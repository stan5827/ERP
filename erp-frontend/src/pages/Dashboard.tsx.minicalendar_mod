const statusColors: Record<string, string> = {
  positive: 'var(--emerald-400)', negative: 'var(--crimson-400)', neutral: 'var(--slate-400)',
  warning: 'var(--amber-400)', info: 'var(--cobalt-400)',
};

function KpiCard({ kpi, delay }: { kpi: DashboardKpi; delay: number }) {
  const [visible, setVisible] = React.useState(false);
  React.useEffect(() => { const t = setTimeout(() => setVisible(true), delay); return () => clearTimeout(t); }, [delay]);
  const color = statusColors[kpi.color || 'neutral'] || statusColors.neutral;
  return (
    <div className={`kpi-card ${visible ? 'visible' : ''}`} style={{ '--delay': `${delay}ms` } as React.CSSProperties}>
      <div className="kpi-card-bg" style={{ background: `radial-gradient(ellipse at top right, ${color}12, transparent 60%)` }} />
      <div className="kpi-card-top">
        <div className="kpi-title">{kpi.title}</div>
        <div className="kpi-status-dot" style={{ background: color, boxShadow: `0 0 8px ${color}80` }}>
          <div className="pulse-ring" style={{ borderColor: color }} />
        </div>
      </div>
      <div className="kpi-value-row">
        <span className="kpi-big-value">{kpi.value}</span>
        {kpi.unit && <span className="kpi-unit">{kpi.unit}</span>}
      </div>
      {kpi.changePercent !== undefined && (
        <div className="kpi-trend" style={{ color: kpi.changeDirection === 'up' ? 'var(--emerald-400)' : 'var(--crimson-400)' }}>
          {kpi.changeDirection === 'up' ? <TrendingUp size={12} /> : <TrendingDown size={12} />}
          <span>{kpi.changePercent > 0 ? '+' : ''}{kpi.changePercent}%</span>
          <span className="kpi-trend-label">vs 上月</span>
        </div>
      )}
      <div className="kpi-bottom-line" style={{ background: `linear-gradient(90deg, ${color}, transparent)` }} />
    </div>
  );
}

function WorkOrderItem({ wo }: { wo: WorkOrderSummary }) {
  const priorityColors: Record<string, string> = { urgent: 'var(--crimson-400)', high: 'var(--amber-400)', normal: 'var(--cobalt-400)', low: 'var(--slate-500)' };
  const progress = wo.plannedQty > 0 ? Math.round((wo.completedQty / wo.plannedQty) * 100) : 0;
  return (
    <div className="wo-item">
      <div className="wo-item-header">
        <div className="wo-item-left">
          <div className="wo-priority-bar" style={{ background: priorityColors[wo.priority] || priorityColors.normal }} />
          <div>
            <div className="wo-number">{wo.woNumber}</div>
            <div className="wo-product">{wo.productName || '未知產品'}</div>
          </div>
        </div>
        <span className={`status-badge status-${wo.status === 'completed' ? 'active' : wo.status === 'in_progress' ? 'warning' : 'neutral'}`}>
          {wo.status === 'completed' ? '完成' : wo.status === 'in_progress' ? '進行中' : wo.status === 'released' ? '已派發' : '待派發'}
        </span>
      </div>
      <div className="wo-progress-row">
        <div className="progress-bar" style={{ flex: 1 }}>
          <div className="progress-fill" style={{ width: `${Math.min(progress, 100)}%`, background: progress >= 100 ? 'var(--emerald-400)' : progress < 60 ? 'var(--amber-400)' : 'var(--cobalt-400)' }} />
        </div>
        <span className="wo-progress-pct">{progress}%</span>
      </div>
      <div className="wo-meta">
        <span>計畫 {wo.plannedQty}</span>
        <span>完成 {wo.completedQty}</span>
        {wo.dueDate && <span>截止 {new Date(wo.dueDate).toLocaleDateString('zh-TW')}</span>}
      </div>
    </div>
  );
}

const CustomTooltip = ({ active, payload, label }: { active?: boolean; payload?: Array<{ name: string; value: number; color: string }>; label?: string }) => {
  if (!active || !payload?.length) return null;
  return (
    <div className="chart-tooltip glass-card no-lift">
      <div className="chart-tooltip-label">{label}</div>
      {payload.map((p, i) => (
        <div key={i} className="chart-tooltip-row">
          <div style={{ width: 8, height: 8, borderRadius: 2, background: p.color, flexShrink: 0 }} />
          <span style={{ color: 'var(--slate-400)' }}>{p.name}</span>
          <span style={{ color: 'var(--slate-100)', marginLeft: 'auto', paddingLeft: 12 }}>{p.value.toLocaleString()}</span>
        </div>
      ))}
    </div>
  );
};

