export function Dashboard({ onNavigate }: { onNavigate?: (id: ModuleId) => void }) {
  const { data: resp, isLoading, error } = useDashboard();
  const data = resp?.data;

  // Fetch this month's calendar events for the mini calendar
  const today = new Date();
  const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
  const monthEnd = new Date(today.getFullYear(), today.getMonth() + 2, 0);
  const { data: calendarResp } = useCalendarRange(
    monthStart.toISOString().slice(0, 10),
    monthEnd.toISOString().slice(0, 10)
  );
  const calendarEvents = (calendarResp?.data as CalendarEventDto[]) || [];

  const navigate = onNavigate || (() => {});

  if (isLoading) return (
    <div className="dashboard page-enter">
      <div className="dashboard-header">
        <div>
          <div className="skeleton" style={{ width: 80, height: 14, marginBottom: 8 }} />
          <div className="skeleton" style={{ width: 200, height: 28, marginBottom: 6 }} />
          <div className="skeleton" style={{ width: 320, height: 12 }} />
        </div>
      </div>
      <div className="kpi-grid">
        {[0, 1, 2, 3].map(i => <SkeletonKpiCard key={i} />)}
      </div>
    </div>
  );

  if (error || !data) return (
    <div className="dashboard page-enter" style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', minHeight: 400 }}>
      <div style={{ textAlign: 'center', color: 'var(--crimson-400)' }}>
        <AlertTriangle size={32} style={{ marginBottom: 12 }} />
        <div>無法載入儀表板資料</div>
      </div>
    </div>
  );

  return (
    <div className="dashboard page-enter">
      <div className="dashboard-header">
        <div>
          <div className="dashboard-greeting">系統概覽</div>
          <div className="dashboard-title">企業神經中樞</div>
          <div className="dashboard-subtitle">在職人數 {data.totalEmployees} 人 | 今日出勤 {data.todayAttendanceCount} 人 | 待審批 {data.pendingApprovals} 件</div>
        </div>
      </div>

      <div className="kpi-grid">
        {data.kpiCards.map((kpi, i) => <KpiCard key={i} kpi={kpi} delay={i * 80} />)}
      </div>

      <div className="chart-grid">
        <div className="glass-card no-lift chart-section chart-section-wide">
          <div className="section-header">
            <div>
              <h3 className="section-title">生產效率趨勢</h3>
              <div className="section-subtitle">近 7 天</div>
            </div>
            <div className="chart-legend">
              <div className="legend-item"><div className="legend-dot" style={{ background: 'var(--cobalt-400)' }} /><span>計畫</span></div>
              <div className="legend-item"><div className="legend-dot" style={{ background: 'var(--emerald-400)' }} /><span>實際</span></div>
            </div>
          </div>
          <ResponsiveContainer width="100%" height={200}>
            <AreaChart data={data.productionTrend} margin={{ top: 5, right: 8, bottom: 0, left: -30 }}>
              <defs>
                <linearGradient id="gPlanned" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stopColor="var(--cobalt-400)" stopOpacity={0.3} /><stop offset="100%" stopColor="var(--cobalt-400)" stopOpacity={0} /></linearGradient>
                <linearGradient id="gActual" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stopColor="var(--emerald-400)" stopOpacity={0.3} /><stop offset="100%" stopColor="var(--emerald-400)" stopOpacity={0} /></linearGradient>
              </defs>
              <CartesianGrid strokeDasharray="3 3" stroke="rgba(148,163,184,0.08)" />
              <XAxis dataKey="date" tick={{ fill: 'var(--slate-500)', fontSize: 11 }} axisLine={false} tickLine={false} />
              <YAxis tick={{ fill: 'var(--slate-500)', fontSize: 11 }} axisLine={false} tickLine={false} />
              <Tooltip content={<CustomTooltip />} />
              <Area type="monotone" dataKey="planned" name="計畫" stroke="var(--cobalt-400)" fill="url(#gPlanned)" strokeWidth={2} />
              <Area type="monotone" dataKey="actual" name="實際" stroke="var(--emerald-400)" fill="url(#gActual)" strokeWidth={2} />
            </AreaChart>
          </ResponsiveContainer>
        </div>

        <div className="glass-card no-lift chart-section">
          <div className="section-header">
            <div><h3 className="section-title">出勤人數趨勢</h3><div className="section-subtitle">近 7 天</div></div>
          </div>
          <ResponsiveContainer width="100%" height={200}>
            <BarChart data={data.attendanceTrend} margin={{ top: 5, right: 8, bottom: 0, left: -30 }}>
              <CartesianGrid strokeDasharray="3 3" stroke="rgba(148,163,184,0.08)" />
              <XAxis dataKey="date" tick={{ fill: 'var(--slate-500)', fontSize: 11 }} axisLine={false} tickLine={false} />
              <YAxis tick={{ fill: 'var(--slate-500)', fontSize: 11 }} axisLine={false} tickLine={false} />
              <Tooltip content={<CustomTooltip />} />
              <Bar dataKey="present" name="出勤" fill="var(--emerald-400)" radius={[3, 3, 0, 0]} />
              <Bar dataKey="late" name="遲到" fill="var(--amber-400)" radius={[3, 3, 0, 0]} />
            </BarChart>
          </ResponsiveContainer>
        </div>
      </div>

      <div className="dashboard-row">
        {/* 生產工單進度 */}
        <div className="glass-card no-lift dashboard-card dashboard-card-wide">
          <div className="section-header">
            <div><h3 className="section-title">生產工單進度</h3><div className="section-subtitle">近期工單</div></div>
          </div>
          <div className="wo-list">
            {data.recentWorkOrders.map(wo => <WorkOrderItem key={wo.id} wo={wo} />)}
            {data.recentWorkOrders.length === 0 && <div style={{ textAlign: 'center', padding: 24, color: 'var(--slate-500)', fontSize: 13 }}>無近期工單</div>}
          </div>
        </div>

        <div className="dashboard-right">
          {/* 系統警示 */}
