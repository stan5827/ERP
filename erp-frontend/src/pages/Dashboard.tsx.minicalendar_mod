              {data.alerts.length === 0 && <div style={{ textAlign: 'center', padding: 16, color: 'var(--slate-500)', fontSize: 12 }}>無系統警示</div>}
            </div>
          </div>

          {/* ── 今日行程 Widget ── */}
          <TodayEventsWidget events={calendarEvents} onNavigate={navigate} />

          {/* ── 快捷工具箱 ── */}
          <div className="glass-card quick-actions-card" style={{ padding: '16px' }}>
            <div className="section-header" style={{ padding: 0, marginBottom: 12 }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
                <Zap size={14} style={{ color: 'var(--cobalt-300)' }} />
                <h3 className="section-title" style={{ fontSize: 13 }}>快捷工具箱</h3>
              </div>
            </div>
            <div className="quick-action-grid">
              {quickActions.map((a, i) => (
                <button key={i} className="quick-action-btn" onClick={() => navigate(a.action as any)}>
                  <div className="quick-action-icon" style={{ color: a.color, background: `${a.color}15` }}>
                    {a.icon}
