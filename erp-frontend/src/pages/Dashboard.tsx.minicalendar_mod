            <div className="section-header">
              <div><h3 className="section-title">系統警示</h3><div className="section-subtitle">{data.activeAlerts} 項異常</div></div>
            </div>
            <div className="alert-list">
              {data.alerts.map(a => (
                <div key={a.id} className="alert-item" style={{ background: a.severity === 'danger' ? 'rgba(199,31,61,0.08)' : a.severity === 'warning' ? 'rgba(179,106,0,0.08)' : 'rgba(45,110,245,0.06)', borderLeft: `3px solid ${a.severity === 'danger' ? 'var(--crimson-400)' : a.severity === 'warning' ? 'var(--amber-400)' : 'var(--cobalt-400)'}` }}>
