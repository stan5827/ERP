import React, { useState } from 'react';
import {
  LayoutDashboard, ShoppingCart, Truck, Package, Factory,
  ShieldCheck, Users, Landmark, Building2, PieChart,
  FlaskConical, Leaf, BrainCircuit, MessageSquare,
  ChevronLeft, ChevronRight, Settings, HelpCircle,
  Scale, Network, DollarSign, GitBranch, CalendarDays,
  ClipboardList, CalendarClock, Map, Wrench, Scan,
  Link, Clock, FileOutput, Lightbulb, Moon, Sun,
  type LucideIcon
} from 'lucide-react';
import type { ModuleId } from '../types';
import { useTheme } from '../theme/ThemeProvider';
import './Sidebar.css';

const iconMap: Record<string, LucideIcon> = {
  LayoutDashboard, ShoppingCart, Truck, Package, Factory,
  ShieldCheck, Users, Landmark, Building2, PieChart,
  FlaskConical, Leaf, BrainCircuit, MessageSquare, Scale, Network, DollarSign, GitBranch, CalendarDays,
  ClipboardList, CalendarClock, Map, Wrench, Scan,
  Link, Clock, FileOutput, Lightbulb,
};

interface NavGroup {
  label: string;
  items: {
    id: ModuleId;
    label: string;
    icon: string;
    badge?: number;
    group: string;
  }[];
}

interface SidebarProps {
  activeModule: ModuleId;
  onModuleChange: (id: ModuleId) => void;
  collapsed: boolean;
  onCollapseToggle: () => void;
}

const navGroups: NavGroup[] = [
  {
    label: '主要',
    items: [
      { id: 'dashboard', label: '儀表板', icon: 'LayoutDashboard', group: 'main' },
    ],
  },
  {
    label: '核心業務',
    items: [
      { id: 'sales', label: '銷貨管理', icon: 'ShoppingCart', badge: 3, group: 'business' },
      { id: 'procurement', label: '採購管理', icon: 'Truck', badge: 5, group: 'business' },
      { id: 'inventory', label: '庫存管理', icon: 'Package', group: 'business' },
      { id: 'manufacturing', label: '生產製造', icon: 'Factory', group: 'business' },
      { id: 'quality', label: '品質管理', icon: 'ShieldCheck', group: 'business' },
    ],
  },
  {
    label: '支援功能',
    items: [
      { id: 'hr', label: '人力資源', icon: 'Users', badge: 7, group: 'support' },
      { id: 'finance', label: '財務管理', icon: 'Landmark', group: 'support' },
      { id: 'assets', label: '固定資產', icon: 'Building2', group: 'support' },
      { id: 'budget', label: '預算規劃', icon: 'PieChart', group: 'support' },
      { id: 'rd', label: '研發管理', icon: 'FlaskConical', group: 'support' },
      { id: 'uom', label: '單位量測', icon: 'Scale', group: 'support' },
      { id: 'org', label: '組織架構', icon: 'Network', group: 'support' },
      { id: 'costcenter', label: '成本中心', icon: 'DollarSign', group: 'support' },
    ],
  },
  {
    label: '數位轉型',
    items: [
      { id: 'esg', label: 'ESG 永續', icon: 'Leaf', group: 'digital' },
      { id: 'ai', label: 'AI 監控中心', icon: 'BrainCircuit', group: 'digital' },
      { id: 'agentflows', label: 'Agent Flow', icon: 'GitBranch', group: 'digital' },
      { id: 'collaboration', label: '協作平台', icon: 'MessageSquare', group: 'digital' },
      { id: 'calendar', label: '行事曆', icon: 'CalendarDays', group: 'digital' },
      { id: 'supplierportal', label: '供應商入口', icon: 'Link', group: 'digital' },
      { id: 'aischeduling', label: 'AI 智能排班', icon: 'Clock', group: 'digital' },
      { id: 'aidecision', label: 'AI 決策助手', icon: 'Lightbulb', group: 'digital' },
      { id: 'ediexport', label: 'EDI 匯出', icon: 'FileOutput', group: 'digital' },
    ],
  },
  {
    label: '計劃與排程',
    items: [
      { id: 'mrp', label: 'MRP 物料需求', icon: 'ClipboardList', group: 'planning' },
      { id: 'aps', label: 'APS 有限產能', icon: 'CalendarClock', group: 'planning' },
      { id: 'mps', label: 'MPS 主生產排程', icon: 'Map', group: 'planning' },
      { id: 'tpm', label: '設備維護 TPM', icon: 'Wrench', group: 'planning' },
      { id: 'barcode', label: '條碼系統', icon: 'Scan', group: 'planning' },
      { id: 'engineering', label: '工藝設計', icon: 'Settings', group: 'planning' },
    ],
  },
];

export const Sidebar: React.FC<SidebarProps> = ({
  activeModule,
  onModuleChange,
  collapsed,
  onCollapseToggle,
}) => {
  const [, setHoveredItem] = useState<string | null>(null);
  const { themeName, setTheme } = useTheme();

  const themeOptions = [
    { id: 'modern-dark', name: '現代深色', icon: Moon },
    { id: 'professional-light', name: '淺色專業', icon: Sun },
    { id: 'high-contrast', name: '高對比', icon: Moon }
  ];

  const handleThemeSelect = (themeId: any) => {
    setTheme(themeId);
  };

  return (
    <aside
      className="sidebar"
      style={{
        width: collapsed ? 'var(--sidebar-collapsed)' : 'var(--sidebar-width)',
      }}
    >
      {/* Logo 區塊 */}
      <div className="sidebar-logo">
        <div className="sidebar-logo-icon">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
            <polygon
              points="11,2 20,7 20,15 11,20 2,15 2,7"
              fill="none"
              stroke="var(--cobalt-300)"
              strokeWidth="1.5"
            />
            <polygon
              points="11,6 16,9 16,13 11,16 6,13 6,9"
              fill="var(--cobalt-500)"
              opacity="0.6"
            />
            <circle cx="11" cy="11" r="2" fill="var(--cobalt-200)" />
          </svg>
        </div>
        {!collapsed && (
          <div className="sidebar-logo-text">
            <div className="sidebar-logo-brand">ProMES</div>
            <div className="sidebar-logo-sub">製造業ERP系統</div>
          </div>
        )}
      </div>

      {/* 導覽清單 */}
      <nav className="sidebar-nav">
        {navGroups.map((group) => (
          <div key={group.label} className="sidebar-nav-group">
            {!collapsed && (
              <div className="sidebar-group-label">{group.label}</div>
            )}
            {group.items.map((item) => {
              const Icon = iconMap[item.icon];
              const isActive = activeModule === item.id;
              return (
                <button
                  key={item.id}
                  className={`sidebar-nav-item ${isActive ? 'active' : ''}`}
                  onClick={() => onModuleChange(item.id)}
                  onMouseEnter={() => setHoveredItem(item.id)}
                  onMouseLeave={() => setHoveredItem(null)}
                  title={collapsed ? item.label : undefined}
                >
                  <span className="sidebar-nav-icon">
                    {Icon && <Icon size={16} />}
                  </span>
                  {!collapsed && (
                    <span className="sidebar-nav-label">{item.label}</span>
                  )}
                  {item.badge && item.badge > 0 && (
                    <span className={`sidebar-badge ${collapsed ? 'collapsed' : ''}`}>
                      {item.badge}
                    </span>
                  )}
                  {isActive && <span className="sidebar-active-indicator" />}
                </button>
              );
            })}
          </div>
        ))}
        
        {/* 主題選項 */}
        {!collapsed && (
          <div className="sidebar-nav-group">
            <div className="sidebar-group-label">顯示設定</div>
            {themeOptions.map(option => {
              const isActive = themeName === option.id;
              return (
                <button
                  key={`theme-${option.id}`}
                  className={`sidebar-nav-item ${isActive ? 'active' : ''}`}
                  onClick={() => handleThemeSelect(option.id)}
                  onMouseEnter={() => setHoveredItem(`theme-${option.id}`)}
                  onMouseLeave={() => setHoveredItem(null)}
                >
                  <span className="sidebar-nav-icon">
                    <option.icon size={16} />
                  </span>
                  <span className="sidebar-nav-label">{option.name}</span>
                  {isActive && <span className="sidebar-active-indicator" />}
                </button>
              );
            })}
          </div>
        )}
      </nav>

      {/* 底部工具 */}
      <div className="sidebar-footer">
        {!collapsed && (
           <>
             <button className="sidebar-footer-btn" disabled title="功能開發中" style={{ opacity: 0.5, cursor: 'not-allowed' }}>
               <HelpCircle size={15} />
               <span>說明文件</span>
         
