{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ErpGeneral": "${DB_CONNECTION_STRING}"
  },
  "Jwt": {
    "Key": "${JWT_SECRET_KEY}",
    "Issuer": "ErpGeneral",
    "Audience": "ErpGeneralUsers",
    "ExpireMinutes": 480
  },
  "LLM": {
    "Provider": "${LLM_PROVIDER}",
    "ApiKey": "${LLM_API_KEY}",
    "BaseUrl": "${LLM_BASE_URL}",
    "DefaultModel": "${LLM_DEFAULT_MODEL}",
    "MaxTokens": 2000,
    "Temperature": 0.7,
    "TimeoutSeconds": 60
  }
}