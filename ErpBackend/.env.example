# ERP Backend Environment Configuration
# Copy this file to .env and fill in the values

# Database Configuration
# Format: Host=localhost;Database=erpgeneral;Username=admin;Password=YourPassword
DB_CONNECTION_STRING=Host=localhost;Database=erpgeneral;Username=admin;Password=YourPassword

# JWT Configuration (must be at least 32 characters)
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_OF_32_CHARACTERS_OR_MORE

# LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your-openai-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_MODEL=gpt-4

# CAPA attachment services (MinIO bucket must be private and pre-created)
CapaAttachments__MinioServiceUrl=https://minio.internal
CapaAttachments__MinioBucket=erp-capa-private
CapaAttachments__MinioAccessKey=replace-with-secret-manager-value
CapaAttachments__MinioSecretKey=replace-with-secret-manager-value
CapaAttachments__MinioRegion=us-east-1
CapaAttachments__ClamAvHost=clamav.internal
CapaAttachments__ClamAvPort=3310
CapaAttachments__ClamAvTimeoutSeconds=30
# Set true only for local Development with a loopback MinIO endpoint.
CapaAttachments__AllowInsecureLocalMinio=false

# Required before employee-app attendance punches can succeed.
# Use the official company coordinates; punches fail closed when any value is missing.
AttendanceGeofence__Latitude=
AttendanceGeofence__Longitude=
AttendanceGeofence__RadiusMeters=
AttendanceGeofence__TimeZoneId=Asia/Taipei