# Auto detect text files and perform LF normalization
* text=auto

# Source code (force LF)
*.cs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Solution and project files
*.sln text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf

# Config files
*.config text eol=lf
.env* text eol=lf

# Binary files (no diff)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.db binary
*.sqlite binary
*.pfx binary
*.key binary
*.cer binary

